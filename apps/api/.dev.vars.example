# apps/api용 로컬 시크릿 - .dev.vars로 복사 후 채우기 (커밋 금지)
ANTHROPIC_API_KEY=sk-ant-...
FIELD_ENCRYPTION_KEY=32바이트-hex
SESSION_SECRET=랜덤-문자열
ADMIN_IP_ALLOWLIST=127.0.0.1
# 시책안 OCR (F-043~) - 없으면 OCR 라우트만 실패, 나머지 기능 무관
CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=
UPSTAGE_API_KEY=
# UPSTAGE_BASE_URL / UPSTAGE_MODEL 은 선택 - 미설정 시 코드 기본값(api.upstage.ai/v1, solar-mini)
# OTP 이메일 발송 (F-033, 로컬 테스트 시에만)
RESEND_API_KEY=
