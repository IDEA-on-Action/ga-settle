{
  "name": "api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "deploy": "wrangler deploy",
    "deploy:prod": "wrangler deploy --env production",
    "deploy:prod:dry": "wrangler deploy --env production --dry-run",
    "d1:migrate:local": "wrangler d1 migrations apply ga-settle-db --local",
    "d1:migrate:remote": "wrangler d1 migrations apply ga-settle-db --remote"
  },
  "dependencies": {
    "@ga-settle/mapping": "workspace:*",
    "@ga-settle/rules": "workspace:*",
    "@ga-settle/schema": "workspace:*",
    "drizzle-orm": "^0.36.0",
    "hono": "^4.6.0",
    "pdf-lib": "^1.17.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.5.0",
    "@cloudflare/workers-types": "^4.20241100.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "wrangler": "^3.90.0"
  }
}
